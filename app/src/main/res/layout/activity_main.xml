<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Palm Float Zello"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="32dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ปุ่มลอยสำหรับกดพูดใน Zello"
        android:textSize="16sp"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btnEnableAccessibility"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1. เปิดสิทธิ์ Accessibility"
        android:layout_marginTop="32dp" />

    <Button
        android:id="@+id/btnOpenZello"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="2. เปิดแอป Zello"
        android:layout_marginTop="12dp" />

    <Button
        android:id="@+id/btnStartFloat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="3. เริ่มปุ่มลอย"
        android:layout_marginTop="12dp" />

</LinearLayout>
